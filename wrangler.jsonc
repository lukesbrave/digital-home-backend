{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starter3-canary-backend",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.ts",
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "starter3-canary-backend"
    },
    {
      "binding": "FRONTEND_WORKER",
      "service": "starter3-canary-frontend"
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://iotldbnwtnzpwpyhwgmo.supabase.co",
    "NEXT_PUBLIC_SUPABASE_URL": "https://iotldbnwtnzpwpyhwgmo.supabase.co",
    "DIGITAL_HOME_URL": "https://starter3-canary-frontend.luke-9ffworkersdev.workers.dev",
    "NEXT_PUBLIC_DIGITAL_HOME_URL": "https://starter3-canary-frontend.luke-9ffworkersdev.workers.dev",
    "SOCIAL_PUBLISHING_ENABLED": "false",
    "API_SIGNATURE_REQUIRED": "true",
    "PUBLIC_MEDIA_BASE": "https://starter3-canary-backend.luke-9ffworkersdev.workers.dev/media"
  },
  "triggers": {
    "crons": []
  },
  "images": {
    "binding": "IMAGES"
  },
  "r2_buckets": [
    {
      "binding": "PUBLIC_MEDIA",
      "bucket_name": "starter3-recovery-source-20261103"
    }
  ]
}
